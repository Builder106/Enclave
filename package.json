{
  "name": "enclave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/generate.ts",
    "measure": "tsx scripts/measure.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "e2e": "bddgen && playwright test",
    "e2e:report": "playwright show-report",
    "demo": "bddgen --config playwright.demo.config.ts && playwright test --config playwright.demo.config.ts",
    "demo:gif": "sh scripts/make-demo-gif.sh"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.67",
    "@ai-sdk/openai-compatible": "^3.0.40",
    "@ai-sdk/solid": "^1.2.13",
    "@kobalte/core": "^0.13.13",
    "@libsql/client": "^0.17.4",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.4",
    "ai": "^7.0.84",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-solid": "^1.35.0",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vinxi": "^0.5.11",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
