{
  "name": "enclave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/generate.ts",
    "measure": "tsx scripts/measure.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "e2e": "bddgen && playwright test",
    "e2e:report": "playwright show-report",
    "demo": "bddgen --config playwright.demo.config.ts && playwright test --config playwright.demo.config.ts",
    "demo:gif": "sh scripts/make-demo-gif.sh"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.55",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@ai-sdk/solid": "^1.2.13",
    "@kobalte/core": "^0.13.13",
    "@libsql/client": "^0.17.4",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^1.3.2",
    "ai": "^7.0.64",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-solid": "^1.31.0",
    "solid-js": "^1.9.14",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.67.0",
    "vinxi": "^0.5.11",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
